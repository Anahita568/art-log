# Copy to .env (gitignored) and fill in. Loaded automatically by `mvn spring-boot:run` from backend/.

# local | cloudinary
IMAGE_STORAGE=cloudinary

# Cloudinary console -> Settings -> API Keys -> "API environment variable"
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Unlocks editing; anyone without it browses read-only. Unset = nobody can edit.
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=
