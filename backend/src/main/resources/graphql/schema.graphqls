type Query {
    artworks(filter: ArtworkFilterInput, sort: ArtworkSort = CREATED_DATE_DESC, page: Int = 0, pageSize: Int = 24): ArtworkPage!
    artwork(id: ID!): Artwork
    tags(type: TagType): [Tag!]!
    "Whether this request carries the admin token, i.e. may run mutations."
    isAdmin: Boolean!
}

"All mutations require the admin token (X-Admin-Token header); queries are public."

type Mutation {
    addArtwork(input: AddArtworkInput!): Artwork!
    updateArtwork(id: ID!, input: UpdateArtworkInput!): Artwork!
    updateArtworkNotes(id: ID!, notes: String): Artwork!
    deleteArtwork(id: ID!): Boolean!
    renameTag(id: ID!, name: String!): Tag!
    deleteTag(id: ID!): Boolean!
}

type ArtworkPage {
    items: [Artwork!]!
    totalCount: Int!
    hasMore: Boolean!
}

enum ArtworkSort {
    CREATED_DATE_DESC
    CREATED_DATE_ASC
    YEAR_DESC
    YEAR_ASC
    TITLE_ASC
}

type Artwork {
    id: ID!
    title: String!
    artist: String
    year: Int
    imageUrl: String
    notes: String
    createdDate: String!
    tags: [Tag!]!
}

type Tag {
    id: ID!
    name: String!
    type: TagType!
    usageCount: Int!
}

enum TagType {
    MEDIUM
    MOVEMENT
    MOOD
    COLOR
    SUBJECT
}

input ArtworkFilterInput {
    mediums: [String!]
    movements: [String!]
    moods: [String!]
    colors: [String!]
    subjects: [String!]
    search: String
}

input AddArtworkInput {
    title: String!
    artist: String
    year: Int
    imageUrl: String
    notes: String
    tags: [TagInput!]
}

input TagInput {
    name: String!
    type: TagType!
}

input UpdateArtworkInput {
    title: String!
    artist: String
    year: Int
    imageUrl: String
    tags: [TagInput!]
}
