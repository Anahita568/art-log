type Query {
    artworks(filter: ArtworkFilterInput): [Artwork!]!
    artwork(id: ID!): Artwork
    tags(type: TagType): [Tag!]!
}

type Mutation {
    addArtwork(input: AddArtworkInput!): Artwork!
    updateArtwork(id: ID!, input: UpdateArtworkInput!): Artwork!
    updateArtworkNotes(id: ID!, notes: String): Artwork!
    deleteArtwork(id: ID!): Boolean!
    renameTag(id: ID!, name: String!): Tag!
    deleteTag(id: ID!): Boolean!
}

type Artwork {
    id: ID!
    title: String!
    artist: String
    year: Int
    imageUrl: String
    notes: String
    createdDate: String!
    tags: [Tag!]!
}

type Tag {
    id: ID!
    name: String!
    type: TagType!
    usageCount: Int!
}

enum TagType {
    MEDIUM
    MOVEMENT
    MOOD
    COLOR
    SUBJECT
}

input ArtworkFilterInput {
    mediums: [String!]
    movements: [String!]
    moods: [String!]
    colors: [String!]
    subjects: [String!]
    search: String
}

input AddArtworkInput {
    title: String!
    artist: String
    year: Int
    imageUrl: String
    notes: String
    tags: [TagInput!]
}

input TagInput {
    name: String!
    type: TagType!
}

input UpdateArtworkInput {
    title: String!
    artist: String
    year: Int
    imageUrl: String
    tags: [TagInput!]
}
